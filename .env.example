# MongoDB connection string (Atlas or local).
# On Vercel: Project Settings → Environment Variables → add MONGODB_URI
# for the Production environment, then redeploy.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/complaint-tracking
# Supported alias (used only when MONGODB_URI is not set):
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/complaint-tracking

# Local fallback:
# MONGODB_URI=mongodb://127.0.0.1:27017/complaint_tracking

# Secret key for JWT / sessions (not required by the public complaint routes).
JWT_SECRET=your-secure-jwt-secret-here

# Public application name
NEXT_PUBLIC_APP_NAME="Complaint Tracking"
